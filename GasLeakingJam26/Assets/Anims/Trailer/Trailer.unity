  m_Script: {fileID: 11500000, guid: 1bbe1763c95ebc947913aff264c750b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicSequence
  imageDisplay: {fileID: 406895085}
  textComponent: {fileID: 734408958}
  fadeOverlay: {fileID: 1883243495}
  slides:
  - image: {fileID: 21300000, guid: 70155ae80b0c154468cad050c41451ed, type: 3}
    texts:
    - "Qu\xE9 buen d\xEDa hace hoy... Huele a caf\xE9, el amanecer es incre\xEDble
      y hasta los p\xE1jaros cantan. Nada podr\xEDa estropear esta ma\xF1ana."
  - image: {fileID: 21300000, guid: 5ec3ecfe68135784884419fae3d3b3bc, type: 3}
    texts:
    - "\xDAltimamente caigo mejor a todo el mundo. Normal... por fin se han dado
      cuenta de lo guapo que soy."
  - image: {fileID: 21300000, guid: d4aab8240adb4e14d87757534379ffd8, type: 3}
    texts:
    - "Mi crush me ha pedido salir hoy. Una semana de planificaci\xF3n, cero margen
      de error. Nada puede salir mal."
  - image: {fileID: 21300000, guid: 7251575b9b92f9e43a2cd430a426dff7, type: 3}
    texts:
    - "A ver que tenemos hoy... Arruga nueva... bueno, no pasa nada. \xBFUn grano?
      Una buena crema y como nuevo. Un momento... \xBFeso es una ENTRADA?"
  textSpeed: 0.03
  imageFadeTime: 0.4
  finalFrames:
  - {fileID: 21300000, guid: f9fabe47c47937245945e9ee8cd2d1d0, type: 3}
  - {fileID: 21300000, guid: 98851e80da600cc42b09ff5c0805b617, type: 3}
